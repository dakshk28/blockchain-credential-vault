FLASK_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Production refuses to start unless both secrets are set to 32+ characters.
SECRET_KEY=replace-with-a-long-random-value
SIGNING_SECRET=replace-with-a-different-long-random-value
DATABASE_URL=postgresql+psycopg://acv:acv@localhost:5432/credential_vault
POSTGRES_PASSWORD=change-this-before-deployment
UPLOAD_DIRECTORY=instance/private_uploads
MAX_CONTENT_LENGTH=10485760
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_MINUTES=15
# Optional antivirus hook: the PDF is piped to stdin; exit code 0 means clean.
# MALWARE_SCAN_COMMAND=clamdscan --no-summary -

# --- Blockchain layer ---
# Ed25519 signing key (auto-created in development at instance/ed25519_signing_key.pem).
# Production: run `flask generate-signing-key` or provide the PEM text in SIGNING_PRIVATE_KEY.
# SIGNING_KEY_FILE=instance/ed25519_signing_key.pem
# Anchor provider: "local" (offline demo) or "ethereum" (see docs/blockchain.md).
BLOCKCHAIN_ANCHOR_PROVIDER=local
# ETH_RPC_URL=https://rpc-amoy.polygon.technology
# ETH_PRIVATE_KEY=0x...            # a testnet-only wallet; never one holding real funds
# ETH_CONTRACT_ADDRESS=0x...       # printed by blockchain/deploy.py
# ETH_CHAIN_ID=80002
# ETH_NETWORK_NAME=Polygon Amoy testnet
# ETH_EXPLORER_TX_URL=https://amoy.polygonscan.com/tx/{tx}
